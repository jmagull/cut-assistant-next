<Window x:Class="CutAssistantNext.App.Dialogs.VideoInformationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video-Informationen"
        Width="760"
        Height="860"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">

    <Window.Resources>
        <Style x:Key="SectionBorderStyle"
               TargetType="Border">
            <Setter Property="Margin"
                    Value="0,0,0,14" />
            <Setter Property="Padding"
                    Value="18" />
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#D9DEE5" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="8" />
        </Style>

        <Style x:Key="SectionHeaderStyle"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,0,0,14" />
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="#1F2937" />
        </Style>

        <Style x:Key="LabelTextStyle"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,5,18,5" />
            <Setter Property="VerticalAlignment"
                    Value="Top" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="#4B5563" />
        </Style>

        <Style x:Key="ValueTextStyle"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,5,0,5" />
            <Setter Property="VerticalAlignment"
                    Value="Top" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="Foreground"
                    Value="#111827" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Text="Video-Informationen" />

            <TextBlock Margin="0,6,0,0"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       Text="Technische Informationen zur aktuell analysierten Mediendatei." />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Grid.IsSharedSizeScope="True">

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="Datei und Container" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="Labels" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Dateiname" />

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding FileName}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Vollständiger Pfad" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       ToolTip="{Binding FilePath}"
                                       Text="{Binding FilePath}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Containerformat" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding ContainerFormat}" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Dateigröße" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding FileSize}" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Laufzeit" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding Duration}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="Video" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="Labels" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Video-Codec" />

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding VideoCodec}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Auflösung" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding Resolution}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="SAR" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding SampleAspectRatio}" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="DAR" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding DisplayAspectRatio}" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Bildrate" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding FrameRate}" />

                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Field Order" />

                            <TextBlock Grid.Row="5"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding FieldOrder}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0"
                        Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="Audio" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="Labels" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Audio-Codec" />

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding AudioCodec}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Samplerate" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding SampleRate}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Kanalanzahl" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding ChannelCount}" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Kanallayout" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding ChannelLayout}" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Width="110"
                Height="34"
                Margin="0,6,0,0"
                HorizontalAlignment="Right"
                IsCancel="True"
                Content="Schließen" />
    </Grid>
</Window>