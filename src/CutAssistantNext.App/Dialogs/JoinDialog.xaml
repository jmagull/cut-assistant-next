<Window x:Class="CutAssistantNext.App.Dialogs.JoinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klebecenter" Width="900" Height="920" MinWidth="680" MinHeight="550"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Zwei Filmteile zusammenfügen" FontSize="23" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Wähle zwei bereits geschnittene MP4-Dateien. Die Dateien werden vollständig in der festgelegten Reihenfolge übernommen. Eine Schnittliste wird nicht angewendet." />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="InputsPanel">
                    <TextBlock Text="1. Filmteile auswählen und Reihenfolge festlegen" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <GroupBox Header="1. Filmteil" Padding="12" Margin="0,0,0,12"><StackPanel>
                        <Button Content="Ersten Filmteil auswählen …" HorizontalAlignment="Left" Padding="12,7" Click="PickFirst" />
                        <TextBox x:Name="FirstPath" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,0" Background="White" />
                    </StackPanel></GroupBox>
                    <Button Content="Reihenfolge tauschen ↕" Padding="12,7" HorizontalAlignment="Center" Click="Swap" Margin="0,0,0,12" />
                    <GroupBox Header="2. Filmteil" Padding="12" Margin="0,0,0,12"><StackPanel>
                        <Button Content="Zweiten Filmteil auswählen …" HorizontalAlignment="Left" Padding="12,7" Click="PickSecond" />
                        <TextBox x:Name="SecondPath" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,0" Background="White" />
                    </StackPanel></GroupBox>
                    <TextBlock Text="2. Tonspuren für QUICK AND COPY" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8" />
                    <TextBlock TextWrapping="Wrap" Text="Eindeutig passende AAC- und AC-3-Spuren werden gemeinsam vorgeschlagen. Prüfe die Zuordnung. Weitere passende Spuren kannst du bewusst zuordnen; nichts wird automatisch ergänzt. Jede Tonspur darf nur einmal zugeordnet werden. Nicht benötigte Paare abwählen." Margin="0,0,0,8" />
                    <ItemsControl x:Name="CopyPairs">
                        <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8"><StackPanel>
                            <CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6">
                                <TextBlock Text="Dieses Tonspurpaar übernehmen (nur bei übereinstimmendem Tonformat)" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="Aus Teil 1:" /><ComboBox ItemsSource="{Binding FirstChoices}" DisplayMemberPath="Description" SelectedItem="{Binding First, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,6" />
                            <TextBlock Text="Dazu aus Teil 2:" /><ComboBox ItemsSource="{Binding SecondChoices}" DisplayMemberPath="Description" SelectedItem="{Binding Second, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                        </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="CopyNotice" TextWrapping="Wrap" Foreground="#92400E" Margin="0,4,0,8" />
                    <CheckBox x:Name="CopyConfirmed" Checked="CopyConfirmationChanged" Unchecked="CopyConfirmationChanged" Margin="0,0,0,16">
                        <TextBlock Text="Ich habe die Zuordnung und die entfallenden Tonspuren geprüft." TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="3. Tonspur für AUDIO-ENTHUSIAST" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8" />
                    <TextBlock Text="Genau eine Tonspur je Teil; Ton einmal durchgehend als AAC-LC neu kodieren." TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="Tonspur für den ersten Filmteil:" /><ComboBox x:Name="FirstAudio" DisplayMemberPath="Description" SelectionChanged="SelectionChanged" Margin="0,4,0,0" />
                    <TextBlock x:Name="FirstNotice" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#92400E" />
                    <TextBlock Text="Tonspur für den zweiten Filmteil:" /><ComboBox x:Name="SecondAudio" DisplayMemberPath="Description" SelectionChanged="SelectionChanged" Margin="0,4,0,0" />
                    <TextBlock x:Name="SecondNotice" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#92400E" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#4B5563" Text="Bei beiden Verfahren bleiben Bild und Originaldateien erhalten. Passende H.264-Bildformate sind erforderlich; AUDIO-ENTHUSIAST setzt zusätzlich durchgehende 25/50 Bilder/s voraus. Danach Anfang, Klebestelle und Ende auf jeder erhaltenen Tonspur kontrollieren. Die Vorschau beginnt drei Sekunden vor der Klebestelle." />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#1E40AF" AutomationProperties.LiveSetting="Polite" Text="Bitte beide Filmteile auswählen." />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="QuickButton" Content="QUICK AND COPY" Padding="14,9" Margin="0,0,10,8" IsEnabled="False" Click="AcceptQuick" />
                <Button x:Name="AcceptButton" Content="AUDIO-ENTHUSIAST – NEUKODIERUNG" Padding="14,9" Margin="0,0,10,8" IsEnabled="False" Click="Accept" />
                <Button Content="Abbrechen" Padding="14,9" Margin="0,0,0,8" IsCancel="True" />
            </WrapPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,6" Text="QUICK AND COPY übernimmt kompatible Bild- und Tonspuren ohne Neukodierung. Technische Hinweise stehen in der Meckerecke des Protokolls. Bitte den fertigen Film kontrollieren." />
            <TextBlock TextWrapping="Wrap" Text="AUDIO-ENTHUSIAST verbindet die Tonspuren samplegenau und kodiert den Ton einmal durchgehend neu." />
        </StackPanel>
    </Grid>
</Window>
