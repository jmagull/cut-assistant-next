<Window x:Class="CutAssistantNext.App.Dialogs.JoinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klebecenter" Width="820" Height="850" MinWidth="640" MinHeight="550"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Zwei Filmteile zusammenfügen" FontSize="23" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Wähle zwei bereits geschnittene MP4-Dateien und die gewünschte Tonspur je Teil. Die Dateien werden vollständig in dieser Reihenfolge übernommen. Eine Schnittliste wird nicht angewendet." />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="InputsPanel">
                    <TextBlock Text="1. Filmteile auswählen und Reihenfolge festlegen" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <GroupBox Header="1. Filmteil" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <Button Content="Ersten Filmteil auswählen …" HorizontalAlignment="Left" Padding="12,7" Click="PickFirst" />
                            <TextBox x:Name="FirstPath" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,8" Background="White" />
                        </StackPanel>
                    </GroupBox>
                    <Button Content="Reihenfolge tauschen ↕" Padding="12,7" HorizontalAlignment="Center" Click="Swap" Margin="0,0,0,12" />
                    <GroupBox Header="2. Filmteil" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <Button Content="Zweiten Filmteil auswählen …" HorizontalAlignment="Left" Padding="12,7" Click="PickSecond" />
                            <TextBox x:Name="SecondPath" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,8" Background="White" />
                        </StackPanel>
                    </GroupBox>
                    <TextBlock Text="2. Tonspur je Filmteil auswählen" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10" />
                    <TextBlock Text="Tonspur für den ersten Filmteil:" Margin="0,0,0,6" />
                    <ComboBox x:Name="FirstAudio" DisplayMemberPath="Description" SelectionChanged="SelectionChanged" />
                    <TextBlock x:Name="FirstNotice" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#92400E" />
                    <TextBlock Text="Tonspur für den zweiten Filmteil:" Margin="0,0,0,6" />
                    <ComboBox x:Name="SecondAudio" DisplayMemberPath="Description" SelectionChanged="SelectionChanged" />
                    <TextBlock x:Name="SecondNotice" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#92400E" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,12"
                           Text="Das Bild bleibt unverändert. Der gewählte Ton wird samplegenau verbunden und einmal durchgehend als AAC neu kodiert. Alle anderen Tonspuren entfallen in der neuen Datei. Beide Ausgangsdateien bleiben erhalten." />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#4B5563"
                           Text="Erste Fassung: passende progressive H.264-Videos mit 25 oder 50 Bildern/s; AAC oder AC-3 mit gleicher Kanalbelegung und Abtastrate. CAN prüft Zeiten, Ton und sämtliche Bildpakete. Anschließend kannst du die Klebestelle mit drei Sekunden Vorlauf kontrollieren." />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#1E40AF" AutomationProperties.LiveSetting="Polite"
                           Text="Bitte beide Filmteile auswählen." />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="AcceptButton" Content="Prüfen und zusammenfügen …" Padding="14,9" Margin="0,0,10,0"
                    IsEnabled="False" IsDefault="True" Click="Accept" />
            <Button Content="Abbrechen" Padding="14,9" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
