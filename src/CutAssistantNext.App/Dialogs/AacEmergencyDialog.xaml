<Window x:Class="CutAssistantNext.App.Dialogs.AacEmergencyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tonspur nach Schnittfehler auswählen"
        Width="720" SizeToContent="Height" MinWidth="580" MaxHeight="650"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14"
                   Text="Mit einer AAC-Tonspur erneut schneiden?" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                    Text="Beim Verarbeiten des Tons ist ein Fehler aufgetreten. Du kannst eine AAC-Spur auswählen. CAN prüft diese Spur vor dem erneuten Schnitt vollständig. Wenn dabei Fehler auftreten, wird der Vorgang abgebrochen." />
                <TextBlock Text="Verfügbare AAC-Spuren" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox x:Name="ChoiceList" MinHeight="65" MaxHeight="180"
                         DisplayMemberPath="Description" SelectionChanged="SelectionChanged" />
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                    Text="Die Ausgabe enthält nur die gewählte AAC-Spur. Alle anderen Tonspuren entfallen in dieser Ausgabe. Die Originalaufnahme bleibt unverändert." />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="AcceptButton" Content="Mit dieser AAC-Spur schneiden" Padding="12,8"
                    Margin="0,0,10,0" IsEnabled="False" IsDefault="True" Click="AcceptClick" />
            <Button Content="Abbrechen" Padding="12,8" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
