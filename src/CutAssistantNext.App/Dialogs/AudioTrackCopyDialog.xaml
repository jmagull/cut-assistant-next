<Window x:Class="CutAssistantNext.App.Dialogs.AudioTrackCopyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tonspur für Filmteile auswählen" Width="750" MinWidth="620"
        SizeToContent="Height" MaxHeight="720" WindowStartupLocation="CenterOwner" Background="#F4F6F8">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="Passende Tonspur für einen weiteren Filmteil" Margin="0,0,0,14" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                    Text="Hat ein Teil eines mehrteiligen Films Probleme mit einer Tonspur und wurde deshalb mit einer anderen Spur geschnitten? Wähle hier für den weiteren Filmteil dieselbe passende Tonspur aus, zum Beispiel Deutsch, AAC, Stereo." />
                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"
                    Text="Lade dafür den bereits geschnittenen Filmteil. Die gesamte geladene Datei wird kopiert; die Schnittliste wird nicht angewendet." />
                <TextBlock x:Name="FileText" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Diese Tonspur soll in der zusätzlichen Kopie erhalten bleiben:" Margin="0,0,0,6" />
                <ListBox x:Name="ChoiceList" DisplayMemberPath="Description" MinHeight="75" MaxHeight="150"
                         SelectionChanged="SelectionChanged" />
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="Bitte die passende Tonspur bewusst auswählen." />
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                    Text="CAN prüft die gewählte Tonspur vollständig. Bild und Ton werden ohne Neukodierung in eine neue MP4-Datei kopiert und vollständig verglichen. Alle anderen Tonspuren entfallen nur in dieser Kopie. Deine bisherige Datei bleibt erhalten." />
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                    Text="Gleiche Sprache, Codec und Kanalzahl helfen beim späteren Zusammenfügen. CAN prüft dabei keinen anderen Filmteil und fügt die Teile hier noch nicht zusammen." />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="AcceptButton" Content="Zusätzliche Kopie speichern …" Padding="12,8" Margin="0,0,10,0"
                    IsEnabled="False" IsDefault="True" Click="AcceptClick" />
            <Button Content="Abbrechen" Padding="12,8" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
