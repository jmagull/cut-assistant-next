<Window x:Class="CutAssistantNext.App.Dialogs.FfmpegSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFmpeg-Werkzeuge"
        Width="720"
        Height="440"
        MinWidth="600"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Text="FFmpeg-Werkzeuge" />

            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#6B7280"
                       Text="Pfade zu ffprobe und FFmpeg konfigurieren" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="18"
                Background="White"
                BorderBrush="#D9DEE5"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel>
                <TextBlock Margin="0,0,0,5"
                           FontWeight="SemiBold"
                           Foreground="#4B5563"
                           Text="ffprobe.exe" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Height="32"
                             Padding="8,4"
                             Text="{Binding FfprobeExecutablePath, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="2"
                            MinWidth="110"
                            Height="32"
                            Padding="12,0"
                            Click="BrowseFfprobeButton_Click"
                            Content="Durchsuchen …" />
                </Grid>

                <TextBlock Margin="0,18,0,5"
                           FontWeight="SemiBold"
                           Foreground="#4B5563"
                           Text="ffmpeg.exe" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Height="32"
                             Padding="8,4"
                             Text="{Binding FfmpegExecutablePath, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="2"
                            MinWidth="110"
                            Height="32"
                            Padding="12,0"
                            Click="BrowseFfmpegButton_Click"
                            Content="Durchsuchen …" />
                </Grid>

                <TextBlock Margin="0,18,0,0"
                           FontSize="12"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           Text="Beide Programmpfade sind frei wählbar. Die Werkzeuge müssen nicht im selben Ordner installiert sein." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

            <Button MinWidth="130"
                    Height="36"
                    Margin="0,0,10,0"
                    Padding="14,0"
                    Click="SaveButton_Click"
                    Content="Speichern" />

            <Button MinWidth="110"
                    Height="36"
                    Padding="14,0"
                    Click="CancelButton_Click"
                    Content="Abbrechen" />
        </StackPanel>
    </Grid>
</Window>
