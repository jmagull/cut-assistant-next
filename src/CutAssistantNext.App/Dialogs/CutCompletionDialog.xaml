<Window x:Class="CutAssistantNext.App.Dialogs.CutCompletionDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schneiden abgeschlossen" Width="660" Height="620" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="BorderBrush" Value="#D9DEE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="8"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#111827" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Width="44" Height="44" CornerRadius="22" Background="#DCFCE7" HorizontalAlignment="Left">
                    <TextBlock Text="✓" FontSize="26" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Schneiden abgeschlossen" FontSize="26" FontWeight="SemiBold"
                           Foreground="#111827" TextWrapping="Wrap" Margin="0,14,0,8" />
                <TextBox Text="{Binding FileName, Mode=OneWay}" ToolTip="{Binding OutputFilePath}"
                         IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                         Padding="0" FontSize="14" Foreground="#4B5563" AutomationProperties.Name="Geschnittene Datei" />
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12"
                        Padding="18" Margin="0,22,0,14">
                    <StackPanel>
                        <TextBlock Text="Stellen zur Kontrolle" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" />
                        <TextBlock Text="{Binding TimeReferenceText}" TextWrapping="Wrap" Foreground="#6B7280" Margin="0,6,0,14" />
                        <ItemsControl ItemsSource="{Binding CheckPoints}" AutomationProperties.Name="Kontrollstellen im geschnittenen Film">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PositionText}" FontFamily="Consolas" FontSize="14" Foreground="#111827" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#4B5563" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding CheckInstructionText}" TextWrapping="Wrap" Foreground="#6B7280" />
                <Expander Header="Protokoll" IsExpanded="False" Margin="0,18,0,0" Foreground="#6B7280">
                    <TextBox x:Name="ProtocolTextBox" IsReadOnly="True" AcceptsReturn="True"
                             MaxHeight="180" Margin="0,8,0,0" Padding="8" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Schnittprotokoll, markierbar und mit Strg+C kopierbar" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="CopyStatusText" Grid.Row="1" MinHeight="20" Margin="0,12,0,8"
                   Foreground="#4B5563" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CopyButton" Content="Hinweise kopieren" Click="CopyButton_Click" />
            <Button x:Name="CloseButton" Grid.Column="2" Content="Schließen" MinWidth="110"
                    Background="#007AFF" Foreground="White" BorderBrush="#007AFF"
                    IsDefault="True" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
