<Window x:Class="CutAssistantNext.App.Dialogs.CutlistGenerationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cutlist erzeugen"
        Width="720"
        Height="720"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Text="Cutlist erzeugen" />

            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#6B7280"
                       Text="Namensdaten und Cutlist-Informationen bearbeiten" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="18"
                Background="White"
                BorderBrush="#D9DEE5"
                BorderThickness="1"
                CornerRadius="8">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>
                    <TextBlock Margin="0,0,0,14"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Text="Namensdaten" />

                    <TextBlock Margin="0,0,0,5"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="Name" />

                    <TextBox Height="32"
                             Padding="8,4"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Margin="0,0,0,5"
                                       FontWeight="SemiBold"
                                       Foreground="#4B5563"
                                       Text="Staffel" />

                            <TextBox Height="32"
                                     Padding="8,4"
                                     Text="{Binding Season, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,5"
                                       FontWeight="SemiBold"
                                       Foreground="#4B5563"
                                       Text="Folge" />

                            <TextBox Height="32"
                                     Padding="8,4"
                                     Text="{Binding Episode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,14,0,5"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="Folgentitel" />

                    <TextBox Height="32"
                             Padding="8,4"
                             Text="{Binding EpisodeTitle, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,14,0,5"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="Namensmaske" />

                    <TextBox Height="32"
                             Padding="8,4"
                             Text="{Binding NameTemplate, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,16,0,5"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="Vorschau" />

                    <Border Padding="10"
                            Background="#F4F6F8"
                            BorderBrush="#D9DEE5"
                            BorderThickness="1"
                            CornerRadius="5">

                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   TextWrapping="Wrap"
                                   Text="{Binding SuggestedMovieName}" />
                    </Border>
                    <TextBlock Margin="0,22,0,14"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Text="Cutlist-Informationen" />

                    <TextBlock Margin="0,0,0,5"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="Autor" />

                    <TextBox Height="32"
                             Padding="8,4"
                             Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#4B5563"
                                   Text="Bewertung" />

                        <TextBlock Margin="0,4,0,8"
                                   Foreground="#6B7280"
                                   Text="Qualität der Cutlist bewusst auswählen – keine Vorauswahl."
                                   TextWrapping="Wrap" />

                        <RadioButton Margin="0,0,0,6"
                                     GroupName="Rating"
                                     Tag="0"
                                     Checked="RatingButton_Checked">
                            <TextBlock TextWrapping="Wrap"
                                       Text="0 – Test / Probecutlist; nicht verwenden" />
                        </RadioButton>

                        <RadioButton Margin="0,0,0,6"
                                     GroupName="Rating"
                                     Tag="1"
                                     Checked="RatingButton_Checked">
                            <TextBlock TextWrapping="Wrap"
                                       Text="1 – Anfang und Ende geschnitten; Werbung kann noch enthalten sein" />
                        </RadioButton>

                        <RadioButton Margin="0,0,0,6"
                                     GroupName="Rating"
                                     Tag="2"
                                     Checked="RatingButton_Checked">
                            <TextBlock TextWrapping="Wrap"
                                       Text="2 – Werbung vollständig, aber nur grob geschnitten (±5 Sekunden)" />
                        </RadioButton>

                        <RadioButton Margin="0,0,0,6"
                                     GroupName="Rating"
                                     Tag="3"
                                     Checked="RatingButton_Checked">
                            <TextBlock TextWrapping="Wrap"
                                       Text="3 – Relativ genau geschnitten (±1 Sekunde)" />
                        </RadioButton>

                        <RadioButton Margin="0,0,0,6"
                                     GroupName="Rating"
                                     Tag="4"
                                     Checked="RatingButton_Checked">
                            <TextBlock TextWrapping="Wrap"
                                       Text="4 – Sehr genau geschnitten (framegenau)" />
                        </RadioButton>

                        <RadioButton GroupName="Rating"
                                     Tag="5"
                                     Checked="RatingButton_Checked">
                            <TextBlock TextWrapping="Wrap"
                                       Text="5 – Sehr genau geschnitten; doppelte Szenen bei Bedarf entfernt" />
                        </RadioButton>
                    </StackPanel>


                    <TextBlock Margin="0,14,0,5"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="Kommentar" />

                    <TextBox MinHeight="80"
                             Padding="8"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding UserComment, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,14,0,5"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="Schnellbausteine" />

                    <ItemsControl ItemsSource="{Binding QuickTexts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button MinHeight="32"
                                        Margin="0,0,8,8"
                                        Padding="10,4"
                                        Click="QuickTextButton_Click"
                                        CommandParameter="{Binding}"
                                        Content="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Margin="0,0,0,8"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   Text="Infos über den Film" />

                        <CheckBox Margin="0,0,0,8"
                                  Content="EPG-Fehler / falscher Inhalt"
                                  IsChecked="{Binding EpgError}" />

                        <TextBlock Margin="20,0,0,5"
                                   Foreground="#4B5563"
                                   Text="Tatsächlicher Inhalt" />

                        <TextBox Height="32"
                                 Margin="20,0,0,10"
                                 Padding="8,4"
                                 IsEnabled="{Binding EpgError}"
                                 Text="{Binding ActualContent, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Margin="0,0,0,6"
                                  Content="Anfang der Aufnahme fehlt"
                                  IsChecked="{Binding MissingBeginning}" />

                        <CheckBox Margin="0,0,0,6"
                                  Content="Ende der Aufnahme fehlt"
                                  IsChecked="{Binding MissingEnding}" />

                        <CheckBox Margin="0,0,0,6"
                                  Content="Video fehlt"
                                  IsChecked="{Binding MissingVideo}" />

                        <CheckBox Margin="0,0,0,8"
                                  Content="Audio fehlt"
                                  IsChecked="{Binding MissingAudio}" />

                        <CheckBox Margin="0,0,0,8"
                                  Content="Sonstiger Fehler"
                                  IsChecked="{Binding OtherError}" />

                        <TextBlock Margin="20,0,0,5"
                                   Foreground="#4B5563"
                                   Text="Beschreibung des sonstigen Fehlers" />

                        <TextBox MinHeight="54"
                                 Margin="20,0,0,0"
                                 Padding="8"
                                 AcceptsReturn="True"
                                 IsEnabled="{Binding OtherError}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding OtherErrorDescription, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,14,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility"
                                        Value="Visible" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TechnicalNotices.Count}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Margin="0,0,0,5"
                                   FontWeight="SemiBold"
                                   Foreground="#4B5563"
                                   Text="Hinweise zur Quelldatei" />

                        <ItemsControl ItemsSource="{Binding TechnicalNotices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="10"
                                            Background="#FFF7ED"
                                            BorderBrush="#FED7AA"
                                            BorderThickness="1"
                                            CornerRadius="5">

                                        <TextBlock Foreground="#9A3412"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Description}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

            <Button MinWidth="130"
                    Height="36"
                    Margin="0,0,10,0"
                    Padding="14,0"
                    Click="SaveButton_Click"
                    Content="Cutlist speichern" />

            <Button MinWidth="110"
                    Height="36"
                    Padding="14,0"
                    Click="CancelButton_Click"
                    Content="Abbrechen" />
        </StackPanel>
    </Grid>
</Window>
