<Window x:Class="CutAssistantNext.App.Dialogs.AppearanceSettingsDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Darstellung und Schnittbearbeitung" Width="560" Height="620" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Anordnung der Benutzeroberfläche" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <RadioButton x:Name="StandardOption" GroupName="Layout" Content="Standard" Margin="0,20,0,4" />
            <TextBlock Text="Player oben, Schnittliste darunter." Margin="20,0,0,0" TextWrapping="Wrap" />
            <RadioButton x:Name="PowerOption" GroupName="Layout" Content="Power-User 1" Margin="0,16,0,4" />
            <TextBlock Text="Großer Player links, Schnittliste und Schnittfunktionen rechts. Bei schmalen Fenstern wird vorübergehend die Standardanordnung verwendet."
                       Margin="20,0,0,0" TextWrapping="Wrap" />
            <RadioButton x:Name="Power2Option" GroupName="Layout" Content="Power-User 2" Margin="0,16,0,4" />
            <TextBlock Text="Kompakter Schnittarbeitsplatz: Schnittbuttons, Halbierungssuche und deutlicher vorgemerkter Anfang beim Player. Mehr Platz für die Schnittliste rechts. Bei Platzmangel vorübergehend Standard."
                       Margin="20,0,0,0" TextWrapping="Wrap" />
            <TextBlock Text="Schnittbearbeitung" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,8" />
            <RadioButton x:Name="RemoveOption" GroupName="CutEditing" Margin="0,4,0,8"><TextBlock Text="Das kann weg – Bereiche zum Entfernen markieren (Rot)" TextWrapping="Wrap" /></RadioButton>
            <RadioButton x:Name="KeepOption" GroupName="CutEditing" Margin="0,4,0,8"><TextBlock Text="Das soll bleiben – Bereiche zum Behalten markieren (Grün)" TextWrapping="Wrap" /></RadioButton>
            <TextBlock Text="Die Arbeitsweise gilt erst für den nächsten neu geöffneten Film. Der aktuelle Schnittplan bleibt unverändert. Im grünen Modus werden nur die markierten Bereiche ausgegeben."
                       TextWrapping="Wrap" Foreground="#4B5563" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Übernehmen" Width="110" Height="32" IsDefault="True" Click="Save_Click" />
                <Button Content="Abbrechen" Width="100" Height="32" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
