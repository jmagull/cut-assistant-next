<Window x:Class="CutAssistantNext.App.Dialogs.CutApplicationSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schnittanwendung"
        Width="720"
        Height="560"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Text="Schnittanwendung" />

            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#6B7280"
                       Text="Programm und Metadaten für die Schnittausführung konfigurieren" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="18"
                Background="White"
                BorderBrush="#D9DEE5"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel>
                <TextBlock Margin="0,0,0,5"
                           FontWeight="SemiBold"
                           Foreground="#4B5563"
                           Text="Name" />

                <TextBox Height="32"
                         Padding="8,4"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,14,0,5"
                           FontWeight="SemiBold"
                           Foreground="#4B5563"
                           Text="Programmdatei" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Height="32"
                             Padding="8,4"
                             Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="2"
                            MinWidth="110"
                            Height="32"
                            Padding="12,0"
                            Click="BrowseButton_Click"
                            Content="Durchsuchen …" />
                </Grid>

                <TextBlock Margin="0,14,0,5"
                           FontWeight="SemiBold"
                           Foreground="#4B5563"
                           Text="Version" />

                <TextBox Height="32"
                         Padding="8,4"
                         Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,14,0,5"
                           FontWeight="SemiBold"
                           Foreground="#4B5563"
                           Text="Optionen" />

                <TextBox Height="32"
                         Padding="8,4"
                         Text="{Binding Options, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,14,0,0"
                           FontSize="12"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           Text="MP4Box ist nicht im Lieferumfang enthalten. Bitte GPAC selbst installieren und unter Programmdatei über Durchsuchen die MP4Box.exe auswählen." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

            <Button MinWidth="130"
                    Height="36"
                    Margin="0,0,10,0"
                    Padding="14,0"
                    Click="SaveButton_Click"
                    Content="Speichern" />

            <Button MinWidth="110"
                    Height="36"
                    Padding="14,0"
                    Click="CancelButton_Click"
                    Content="Abbrechen" />
        </StackPanel>
    </Grid>
</Window>
