<Window x:Class="CutAssistantNext.App.Dialogs.CutOutputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schneiden"
        Width="720"
        Height="650"
        MinWidth="600"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Text="Schneiden" />

            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#6B7280"
                       Text="Zieldateiname für die geschnittene Mediendatei festlegen" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="18"
                Background="White"
                BorderBrush="#D9DEE5"
                BorderThickness="1"
                CornerRadius="8">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>
                    <TextBlock Margin="0,0,0,14"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Text="Namensvorschlag" />

                    <TextBlock Margin="0,0,0,5"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="Name" />

                    <TextBox Height="32"
                             Padding="8,4"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Margin="0,0,0,5"
                                       FontWeight="SemiBold"
                                       Foreground="#4B5563"
                                       Text="Staffel" />

                            <TextBox Height="32"
                                     Padding="8,4"
                                     Text="{Binding Season, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,5"
                                       FontWeight="SemiBold"
                                       Foreground="#4B5563"
                                       Text="Folge" />

                            <TextBox Height="32"
                                     Padding="8,4"
                                     Text="{Binding Episode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,14,0,5"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="Folgentitel" />

                    <TextBox Height="32"
                             Padding="8,4"
                             Text="{Binding EpisodeTitle, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,14,0,5"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="Namensmaske" />

                    <TextBox Height="32"
                             Padding="8,4"
                             Text="{Binding NameTemplate, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,16,0,5"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="Vorschau" />

                    <Border Padding="10"
                            Background="#F4F6F8"
                            BorderBrush="#D9DEE5"
                            BorderThickness="1"
                            CornerRadius="5">

                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   TextWrapping="Wrap"
                                   Text="{Binding SuggestedMovieName}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

            <Button MinWidth="130"
                    Height="36"
                    Margin="0,0,10,0"
                    Padding="14,0"
                    Click="CutButton_Click"
                    Content="Schneiden …" />

            <Button MinWidth="110"
                    Height="36"
                    Padding="14,0"
                    Click="CancelButton_Click"
                    Content="Abbrechen" />
        </StackPanel>
    </Grid>
</Window>
