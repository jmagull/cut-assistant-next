<Window x:Class="CutAssistantNext.App.Dialogs.Mp4BoxProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video vorbereiten und schneiden"
        Width="900"
        Height="620"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Text="Video vorbereiten und schneiden" />

            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#6B7280"
                       Text="Fortschritt und optionales Protokoll" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,14"
                Padding="14"
                Background="White"
                BorderBrush="#D9DEE5"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel>
                <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"
                       TextWrapping="Wrap"
                       Text="{Binding StatusText}" />
                <ProgressBar Height="10" Margin="0,12,0,0" Minimum="0" Maximum="100"
                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding ProgressText}" Foreground="#4B5563" />
                <TextBlock Margin="0,5,0,0" Text="{Binding TimingText}" TextWrapping="Wrap"
                           FontSize="12" Foreground="#6B7280" />
            </StackPanel>
        </Border>

        <Expander Grid.Row="2" Header="Protokoll" IsExpanded="True">
        <Border
                Padding="1"
                Background="White"
                BorderBrush="#D9DEE5"
                BorderThickness="1"
                CornerRadius="8">

            <TextBox x:Name="ProtocolTextBox"
                     Padding="12"
                     Background="#111827"
                     Foreground="#F9FAFB"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="13"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextChanged="ProtocolTextBox_TextChanged"
                     Text="{Binding ProtocolText, Mode=OneWay}" />
        </Border>
        </Expander>

        <Grid Grid.Row="3"
              Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    MinWidth="120"
                    Height="36"
                    Padding="14,0"
                    IsEnabled="{Binding CanCancel}"
                    Click="CancelButton_Click"
                    Content="Abbrechen" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">

                <Button MinWidth="160"
                        Height="36"
                        Margin="0,0,10,0"
                        Padding="14,0"
                        Click="CopyProtocolButton_Click"
                        Content="In Zwischenablage" />

                <Button x:Name="CloseButton"
                        MinWidth="130"
                        Height="36"
                        Padding="14,0"
                        IsEnabled="False"
                        Click="CloseButton_Click"
                        Content="{Binding CloseButtonText}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
