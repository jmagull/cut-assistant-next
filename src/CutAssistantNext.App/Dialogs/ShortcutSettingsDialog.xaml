<Window x:Class="CutAssistantNext.App.Dialogs.ShortcutSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal" Title="Tastenkürzel" Width="690" Height="470" MinHeight="400" MinWidth="620"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="CaptureKey">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="Status" Margin="0,8" MinHeight="32" TextWrapping="Wrap" />
            <WrapPanel Margin="0,0,0,8">
                <Button Margin="0,0,6,0" Padding="8,4" Click="Capture_Click">Tastenkürzel ändern</Button>
                <Button Margin="0,0,6,0" Padding="8,4" Click="Remove_Click">Belegung entfernen</Button>
                <Button Margin="0,0,6,0" Padding="8,4" Click="Reset_Click">Standard</Button>
                <Button Padding="8,4" Click="ResetAll_Click">Alle zurücksetzen</Button>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Padding="14,5" Margin="0,0,6,0" Click="Save_Click">Speichern</Button>
                <Button Padding="14,5" IsCancel="True">Abbrechen</Button>
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="Rows" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Gruppe" Binding="{Binding Group}" Width="140" />
                <DataGridTextColumn Header="Funktion" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Standard" Binding="{Binding Standard}" Width="110" />
                <DataGridTextColumn Header="Belegung" Binding="{Binding Binding}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
