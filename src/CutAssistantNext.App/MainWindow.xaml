<Window x:Class="CutAssistantNext.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CutAssistantNext.App.Controls"
        Title="Cut Assistant Next – Medienanalyse"
        Width="960"
        Height="780"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.Resources>
        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SectionBorderStyle"
               TargetType="Border">
            <Setter Property="Margin"
                    Value="0,0,0,14" />
            <Setter Property="Padding"
                    Value="18" />
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#D9DEE5" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="8" />
        </Style>

        <Style x:Key="SectionHeaderStyle"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,0,0,14" />
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="#1F2937" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Background="White">
            <MenuItem Header="Einstellungen">
                <MenuItem Header="Cutlist-Einstellungen …"
                          Click="CutlistSettingsMenuItem_Click" />

                <MenuItem Header="Namensmaske …"
                          Click="NamingSettingsButton_Click" />

                <Separator />

                <MenuItem Header="Schnittanwendung …"
                          Click="CutApplicationSettingsButton_Click" />

                <MenuItem Header="FFmpeg-Werkzeuge …"
                          Click="FfmpegSettingsButton_Click" />
            </MenuItem>

            <MenuItem Header="Video-Informationen …"
                      Click="VideoInformationMenuItem_Click" />

            <MenuItem Header="Hilfe"
                      IsEnabled="False" />

            <MenuItem Header="Credits"
                      IsEnabled="False" />

            <MenuItem Header="Update/GitHub"
                      IsEnabled="False" />

            <MenuItem Header="Quit"
                      Click="QuitMenuItem_Click" />
        </Menu>

        <Grid Grid.Row="1"
              Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           Text="Cut Assistant Next" />

                <TextBlock Margin="0,5,0,0"
                           FontSize="15"
                           Foreground="#6B7280"
                           Text="Analyse, Schnitt und mehr" />
            </StackPanel>

            <Button Grid.Column="1"
                    MinWidth="190"
                    Height="42"
                    Margin="20,0,0,0"
                    Padding="18,0"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding CanAnalyze}"
                    Click="SelectMediaFileButton_Click"
                    Content="MP4-Datei auswählen" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="10"
                Background="#EAF2FF"
                BorderBrush="#BCD2F2"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontWeight="SemiBold"
                           Foreground="#1E3A5F"
                           Text="{Binding StatusMessage}" />

                <TextBlock Grid.Row="1"
                           Margin="0,4,0,0"
                           Foreground="#1E3A5F"
                           TextWrapping="Wrap"
                           Text="{Binding FileName}" />

                <ProgressBar Grid.Row="2"
                             Height="6"
                             Margin="0,10,0,0"
                             IsIndeterminate="{Binding IsAnalyzing}"
                             Visibility="{Binding IsAnalyzing,
                                 Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,14"
                Padding="14"
                Background="#FFF1F1"
                BorderBrush="#E5A4A4"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasError,
                    Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Foreground="#991B1B"
                           Text="Bei der Analyse ist ein Fehler aufgetreten:" />

                <TextBlock Margin="0,6,0,0"
                           Foreground="#7F1D1D"
                           TextWrapping="Wrap"
                           Text="{Binding ErrorMessage}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Padding="18,10"
                Style="{StaticResource SectionBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="350" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Margin="0,0,0,8"
                           Style="{StaticResource SectionHeaderStyle}"
                           Text="Player" />

                <Border Grid.Row="1"
                        Background="Black"
                        BorderBrush="#374151"
                        BorderThickness="1">
                    <controls:MpvVideoHost x:Name="VideoHost" />
                </Border>

                <Grid x:Name="PlaybackControls"
                      Grid.Row="2"
                      Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.ColumnSpan="8">
                        <Slider x:Name="TimelineSlider"
                                Height="24"
                                Margin="0,0,0,4"
                                Minimum="0"
                                Maximum="{Binding DurationSeconds}"
                                Value="{Binding TimelinePositionSeconds,
                                    Mode=OneWay}"
                                IsEnabled="{Binding CanSeek}"
                                PreviewMouseLeftButtonDown="TimelineSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp"
                                ValueChanged="TimelineSlider_ValueChanged" />

                        <controls:CutTimelineTrack x:Name="CutTimelineTrack"
                                                   Height="12"
                                                   Margin="0,0,0,10"
                                                   MediaDuration="{Binding MediaDuration}"
                                                   RemoveSegments="{Binding RemoveSegments}"
                                                   SelectedRemoveSegment="{Binding SelectedRemoveSegment, Mode=TwoWay}" />
                    </StackPanel>

                    <Button Grid.Row="1"
                            MinWidth="90"
                            Height="36"
                            Padding="14,0"
                            IsEnabled="{Binding CanTogglePlayback}"
                            Click="PlayButton_Click"
                            Content="Play/Pause" />

                    <Button x:Name="StepBackwardFramesButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            MinWidth="90"
                            Height="36"
                            Margin="10,0,0,0"
                            Padding="14,0"
                            IsEnabled="{Binding CanStepFrame}"
                            Click="StepBackwardFramesButton_Click"
                            Content="−10 Bilder" />

                    <Button Grid.Row="1"
                            Grid.Column="2"
                            MinWidth="110"
                            Height="36"
                            Margin="10,0,0,0"
                            Padding="14,0"
                            IsEnabled="{Binding CanStepFrame}"
                            Click="StepBackwardButton_Click"
                            Content="Bild zurück" />

                    <Button Grid.Row="1"
                            Grid.Column="3"
                            MinWidth="110"
                            Height="36"
                            Margin="10,0,0,0"
                            Padding="14,0"
                            IsEnabled="{Binding CanStepFrame}"
                            Click="StepForwardButton_Click"
                            Content="Bild vor" />

                    <Button x:Name="StepForwardFramesButton"
                            Grid.Row="1"
                            Grid.Column="4"
                            MinWidth="90"
                            Height="36"
                            Margin="10,0,0,0"
                            Padding="14,0"
                            IsEnabled="{Binding CanStepFrame}"
                            Click="StepForwardFramesButton_Click"
                            Content="+10 Bilder" />

                    <StackPanel Grid.Row="1"
                                Grid.Column="6"
                                Margin="20,0,20,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#4B5563"
                                   Text="Lautstärke" />

                        <Slider x:Name="VolumeSlider"
                                Width="180"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="5"
                                IsSnapToTickEnabled="False"
                                IsEnabled="{Binding CanSetVolume}"
                                Value="{Binding Volume, Mode=OneWay}"
                                ValueChanged="VolumeSlider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="7"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal">

                            <TextBlock Width="55"
                                       Margin="0,0,18,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold"
                                       TextAlignment="Right"
                                       Text="{Binding VolumeText}" />

                            <TextBlock Margin="0,0,6,0"
                                       FontSize="15"
                                       Foreground="#6B7280"
                                       Text="Position:" />

                            <TextBlock FontFamily="Consolas"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{Binding PositionText}" />

                            <TextBlock Margin="6,0"
                                       FontSize="15"
                                       Foreground="#6B7280"
                                       Text="/" />

                            <TextBlock FontFamily="Consolas"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{Binding DurationText}" />
                        </StackPanel>

                        <StackPanel Margin="0,3,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Text="Geschnitten:" />

                            <TextBlock FontFamily="Consolas"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding DataContext.EstimatedOutputDurationText,
                                           ElementName=CutTimelineTrack}" />
                        </StackPanel>

                        <TextBlock Margin="0,3,0,0"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Text="{Binding FrameText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="CutPlanSection"
                Grid.Row="4"
                Padding="18,10"
                Style="{StaticResource SectionBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,8"
                           Style="{StaticResource SectionHeaderStyle}"
                           Text="Schnittliste" />

                <WrapPanel Grid.Row="1">
                    <Button MinWidth="110"
                            Height="36"
                            Padding="12,0"
                            IsEnabled="{Binding CanSetStart}"
                            Click="SetCutStartAtBeginningButton_Click"
                            Content="Videoanfang" />

                    <Button MinWidth="170"
                            Height="36"
                            Margin="6,0,0,0"
                            Padding="14,0"
                            IsEnabled="{Binding CanSetStart}"
                            Click="SetCutStartButton_Click"
                            Content="Schnittanfang setzen" />

                    <Button MinWidth="170"
                            Height="36"
                            Margin="10,0,0,0"
                            Padding="14,0"
                            IsEnabled="{Binding CanSetEnd}"
                            Click="SetCutEndButton_Click"
                            Content="Schnittende setzen" />

                    <Button MinWidth="110"
                            Height="36"
                            Margin="6,0,0,0"
                            Padding="12,0"
                            IsEnabled="{Binding CanSetEnd}"
                            Click="SetCutEndAtMediaEndButton_Click"
                            Content="Videoende" />

                    <TextBlock Margin="22,0,8,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Text="Vorgemerkter Anfang:" />

                    <TextBlock VerticalAlignment="Center"
                               FontFamily="Consolas"
                               FontWeight="SemiBold"
                               Text="{Binding PendingStartText}" />
                </WrapPanel>

                <DataGrid Grid.Row="2"
                          Margin="0,14,0,0"
                          MinHeight="80"
                          Background="White"
                          Foreground="#111827"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          PreviewMouseLeftButtonDown="RemoveSegmentsDataGrid_PreviewMouseLeftButtonDown"
                          SelectedItem="{Binding SelectedRemoveSegment, Mode=TwoWay}"
                          ItemsSource="{Binding RemoveSegments}">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="RemoveSegmentStartColumn"
                                            Header="Anfang"
                                            Width="*"
                                            Binding="{Binding Start}" />

                        <DataGridTextColumn x:Name="RemoveSegmentEndColumn"
                                            Header="Ende"
                                            Width="*"
                                            Binding="{Binding End}" />

                        <DataGridTextColumn Header="Dauer"
                                            Width="*"
                                            Binding="{Binding Duration}" />
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Grid.Row="3"
                           Margin="0,12,0,0">
                    <Button MinWidth="150"
                            Height="36"
                            Padding="14,0"
                            IsEnabled="{Binding CanModifySelectedSegment}"
                            Click="RemoveCutSegmentButton_Click"
                            Content="Bereich löschen" />

                    <Button MinWidth="170"
                            Height="36"
                            Margin="10,0,0,0"
                            Padding="14,0"
                            Click="GenerateCutlistButton_Click"
                            Content="Cutlist erzeugen …" />

                    <Button MinWidth="170"
                            Height="36"
                            Margin="10,0,0,0"
                            Padding="14,0"
                            Click="UploadCutlistButton_Click"
                            Content="Cutlist auf Server hochladen …" />

                    <Button MinWidth="170"
                            Height="36"
                            Margin="10,0,0,0"
                            Padding="14,0"
                            Click="LoadCutlistButton_Click"
                            Content="Lokale Cutlist laden …" />

                    <Button MinWidth="170"
                            Height="36"
                            Margin="10,0,0,0"
                            Padding="14,0"
                            Click="NamingSettingsButton_Click"
                            Content="Namensmaske …" />

                    <Button MinWidth="170"
                            Height="36"
                            Margin="10,0,0,0"
                            Padding="14,0"
                            Click="CutOutputButton_Click"
                            Content="Schneiden …" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
